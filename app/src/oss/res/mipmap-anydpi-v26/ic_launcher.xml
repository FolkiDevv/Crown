<?xml version="1.0" encoding="utf-8"?>
<!-- Crown: the fork's launcher icon (overrides src/main for the oss flavor). Android 7 has no adaptive icons and
     takes the mipmap-*dpi PNGs next to this directory. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/crown_launcher_background" />
    <foreground android:drawable="@drawable/crown_launcher_foreground" />
    <monochrome android:drawable="@drawable/crown_launcher_monochrome" />
</adaptive-icon>
